prediction.frame = expand.grid(gdp08 = gdp08.mean,
frac_eth = c(frac_eth.min, frac_eth.max))
predictions = predict.glm(modelC, newdata=prediction.frame,
type="response", se.fit=T)
plot(1:2, y=predictions$fit, ylim=c(0,1), axes=F,
xlab="Ethnic Fractionalization",
ylab="Probability of Democracy",
main="Probability of Democracy by Ethnic Fractionalization \n at Mean GDP",
pch=16)
# Add confidence intervals (95% CI with z-score 1.96)
segments(x0=1:2, y0=predictions$fit - 1.96*predictions$se.fit,
x1=1:2, y1=predictions$fit + 1.96*predictions$se.fit)
# Add x-axis
axis(side=1, at=1:2,
labels=c("Low", "High"),
cex.axis=.7)
# Add y-axis
axis(side=2, las=2)
box()
