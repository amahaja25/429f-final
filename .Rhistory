# load library
library(poliscidata)
# 1.)	In the nesD dataset, there are three variables:
# voted2012 (coded 1 for voters, 0 for nonvoters),
# dem_edugroup (an ordered factor coded 1-5),
# and dem_age_group_r (an ordered factor coded 1-13).
# First, transform dem_edugroup and dem_age_group_r into numeric variables.
# Or you could simply enter as.numeric(dem_edugroup) and as.numeric(dem_age_group_r)
# directly into your logit function.
# check levels of each variable
levels(nesD$voted2012)
levels(nesD$dem_edugroup)
levels(nesD$dem_age_group_r)
# transform ordered to numeric for dem_edugroup and dem_age_group_r
nes$dem_edugroup.num <- as.numeric(nes$dem_edugroup)
nes$dem_age_group_r.num <- as.numeric(nes$dem_age_group_r)
# rebuild nesD with new variables
nesD = svydesign(id=~1, data=nes, weights=~wt)
# 1a.)	Run svyglm() on nesD to estimate a new model, “modelA”.
# Obtain a full set of statistics for modelA and report the correct values below.
# Report decimals rounded up to the closest 1,000th (3 digits).
# [The chi-square will have a coefficient and a p-value (but no Odds Ratio);
# the remaining will only have coefficients]
# define model
modelA <- svyglm(voted2012 ~ dem_edugroup.num + dem_age_group_r.num,
design=nesD, family="quasibinomial")
# run model
summary(modelA)
# odds ratio
orci(modelA)
# calculate mcfaddens R2, cox and Snell index, and nagelkerke index of logit
logregR2(modelA)
# 3) If the probability of an event occurring is 0.30, what are the odds of the event?
# What are the logged odds of the event?
# define object with value of the probability of event
probability <- 0.30
# odds ratio formula
odds <- probability / (1 - probability)
# look at odds
odds
# convert to logged odds by logging the odds
logged.odds <- log(odds)
# look at logged odds
logged.odds
# 4)	Estimate a logit that uses the variable polknow3 in the nes dataset to
# explain the likelihood that someone posted a political message on social media (DV is dhsinvolv_message).
# Higher values of polknow3 indicate higher political knowledge of the respondent.
# Don’t forget to make dhsinvolv_message and polknow3 numeric and update the nesD first.
# check levels
levels(nes$polknow3)
levels(nes$dhsinvolv_message)
# transform ordered to numeric
nes$dhsinvolv_message.num <- as.numeric(nes$dhsinvolv_message)
nes$polknow3.num <- as.numeric(nes$polknow3)
# update nes dataset with numeric variables
nesD = svydesign(id=~1, data=nes, weights=~wt)
# define model
modelB <- svyglm(dhsinvolv_message ~ polknow3.num,
design=nesD, family="quasibinomial")
# run model
summary(modelB)
# odds ratio
orci(modelB)
# 4b.)	Create a line graph that plots the predicted probabilities of posting a political message on social media,
# at varying levels of political knowledge. The y-axis of your plot should range from 0 to 1
# and correspond to the predicted probability of posting a message.
# The x-axis of your plot should range from 1 to 3 (the range of polknow3).
# Give your graph a title and appropriate axis labels, then paste it into this assignment.
# define polknow3.values
polknow3.values = seq(1, 3, by=1)
# summary of modelB
summary(modelB)
# define predicted logged odds
predicted.logged.odds = 1.89693 + (-0.29579)*polknow3.values
# define predicted probabilities
predicted.probabilities = inverse.logit(predicted.logged.odds)
# create plot
plot(x="", y="", xlim=range(polknow3.values), ylim=c(0,1),
xlab="Political Knowledge", ylab="Probability of Posting a Political Message on Social Media",
main="Predicted Probability of Posting \n a Political Message on Social Media \n by Political Knowledge")
lines(x=polknow3.values, y=inverse.logit(predicted.logged.odds), lty=1)
prediction.frame <- data.frame(polknow3.num = polknow3.values)
prediction.frame
# Get predicted probabilities
predicted.prob <- predict(modelB, newdata = prediction.frame, type = "response")
predicted.prob
# 5)	The world dataset contains three variables: democ_regime (coded “Yes” or “No” for democracies),
# frac_eth (ranging from 0-1), and gdp08 (a country’s GDP in 2008).
# First, transform democ_regime into a numeric variable so we can use it as our DV (both our IVs are already numeric).
# Also, update the worldD dataset
levels(world$democ_regime)
levels(world$frac_eth)
# make numeric and subtract 1 so the values are 0 and 1 instead of 1 and 2
world$democ_regime.num <- as.numeric(world$democ_regime) - 1
class(world$democ_regime.num)
class(world$frac_eth)
class(world$gdp08)
worldD <- svydesign(id=~1, data=world)
# 5a.) Run a logit that regresses democ_regime on frac_eth nd gdp08.
# svyglm(DV~IV+IV..., design=design.dataset, family="quasibinomial")
modelC <- svyglm(democ_regime.num ~ frac_eth + gdp08,
design=worldD, family="quasibinomial")
summary(modelC)
# get odds ratio
orci(modelC)
