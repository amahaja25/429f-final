# load library
library(poliscidata)
# 1.)	In the nesD dataset, there are three variables:
# voted2012 (coded 1 for voters, 0 for nonvoters),
# dem_edugroup (an ordered factor coded 1-5),
# and dem_age_group_r (an ordered factor coded 1-13).
# First, transform dem_edugroup and dem_age_group_r into numeric variables.
# Or you could simply enter as.numeric(dem_edugroup) and as.numeric(dem_age_group_r)
# directly into your logit function.
# check levels of each variable
levels(nesD$voted2012)
levels(nesD$dem_edugroup)
levels(nesD$dem_age_group_r)
# transform ordered to numeric for dem_edugroup and dem_age_group_r
nes$dem_edugroup.num <- as.numeric(nes$dem_edugroup)
nes$dem_age_group_r.num <- as.numeric(nes$dem_age_group_r)
# rebuild nesD with new variables
nesD = svydesign(id=~1, data=nes, weights=~wt)
# 1a.)	Run svyglm() on nesD to estimate a new model, “modelA”.
# Obtain a full set of statistics for modelA and report the correct values below.
# Report decimals rounded up to the closest 1,000th (3 digits).
# [The chi-square will have a coefficient and a p-value (but no Odds Ratio);
# the remaining will only have coefficients]
# define model
modelA <- svyglm(voted2012 ~ dem_edugroup.num + dem_age_group_r.num,
design=nesD, family="quasibinomial")
# run model
summary(modelA)
# odds ratio
orci(modelA)
# calculate mcfaddens R2, cox and Snell index, and nagelkerke index of logit
logregR2(modelA)
# 3) If the probability of an event occurring is 0.30, what are the odds of the event?
# What are the logged odds of the event?
